# ─────────────────────────────────────────────────────────────
# Frontend (Vite) — SEGURO exponer, son claves publicas de Firebase.
# Copia este archivo a .env y rellena con los valores de tu proyecto Firebase.
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dominio sintetico para los usuarios vendedor (usuario -> usuario@<este dominio>)
VITE_SELLER_EMAIL_DOMAIN=sellers.wxbsolutions.app

# ─────────────────────────────────────────────────────────────
# Netlify Functions (servidor) — NUNCA exponer estas al cliente.
# En Netlify se configuran en Site settings > Environment variables.
# En local, netlify dev las lee de este mismo .env.
# ─────────────────────────────────────────────────────────────

# API key gratuita de Google AI Studio (Gemini). Sin tarjeta.
GEMINI_API_KEY=

# Modelo Gemini a usar. 'gemini-flash-latest' siempre apunta al Flash vigente.
GEMINI_MODEL=gemini-flash-latest

# Service account de Firebase Admin. Pega el JSON completo en UNA linea,
# o usa GOOGLE_APPLICATION_CREDENTIALS apuntando a un archivo.
FIREBASE_SERVICE_ACCOUNT=

# Mismo dominio que arriba, disponible para las funciones.
SELLER_EMAIL_DOMAIN=sellers.wxbsolutions.app

# Notificacion por correo cuando un vendedor agenda una cita, via Resend
# (resend.com, capa gratis). Sin RESEND_API_KEY, el agendado sigue funcionando
# pero no se manda el correo.
RESEND_API_KEY=
# Mientras no se verifique un dominio propio en Resend, hay que usar este remitente.
RESEND_FROM=wxbsolutions <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=gaelrb2903@gmail.com
