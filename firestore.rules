rules_version = '2';

// Reglas de seguridad de Firestore para la plataforma wxbsolutions.
// Desplegar con: firebase deploy --only firestore:rules
// (o pegar en Firebase Console > Firestore > Reglas).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }

    // Negocios: cualquier usuario autenticado los ve. Los vendedores solo
    // pueden actualizar (cambiar estatus). Crear/borrar y demas, solo admin.
    match /businesses/{id} {
      allow read: if signedIn();
      allow update: if signedIn();      // vendedores cambian estatus / admin todo
      allow create, delete: if isAdmin();

      // Notas internas del equipo sobre el prospecto. Cualquiera autenticado
      // las lee y agrega; no se editan ni se borran (salvo admin).
      match /comments/{commentId} {
        allow read, create: if signedIn();
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Citas: el vendedor crea, lee, edita y borra las suyas (no las de otros
    // vendedores); el admin ve, edita y borra todas. request.resource.data.sellerId
    // == auth.uid en el update evita que un vendedor "reasigne" la cita a otro.
    match /appointments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.sellerId == request.auth.uid
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid);
    }

    // Usuarios: cada quien lee su propio doc; el admin lee todos.
    // La escritura la hacen las Netlify Functions con el Admin SDK (ignora reglas).
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }
  }
}
